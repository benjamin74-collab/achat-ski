generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* -----------------------------
   AUTH (NextAuth / PrismaAdapter)
------------------------------ */
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  role          Role     @default(USER)

  // Relations
  accounts      Account[]
  sessions      Session[]

  reviews       Review[]
  tests         EditorialTest[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  USER
}

/* -----------------------------
   CATALOGUE / OFFRES
------------------------------ */
model Product {
  id          Int             @id @default(autoincrement())
  brand       String
  model       String
  season      String? // ex: "2025/26"
  category    String? // all-mountain, rando, freeride...
  gtin        String?         @unique
  slug        String          @unique
  attributes  Json?
  createdAt   DateTime        @default(now())
  description String?
  skus        Sku[]
  clicks      Click[] // back-relation pour Click.product
  reviews     Review[]
  tests       EditorialTest[]
}

model Sku {
  id         Int     @id @default(autoincrement())
  product    Product @relation(fields: [productId], references: [id])
  productId  Int
  variant    String? // 172 cm, 180 cm...
  gtin       String? @unique
  attributes Json?
  offers     Offer[]
}

model Merchant {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  slug      String  @unique
  network   String? // kwanko | awin | sovrn | direct
  programId String?
  status    String? // active | paused
  offers    Offer[]
}

model Offer {
  id            Int       @id @default(autoincrement())
  sku           Sku       @relation(fields: [skuId], references: [id])
  skuId         Int
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  merchantId    Int
  affiliateUrl  String
  priceCents    Int
  currency      String // "EUR"
  inStock       Boolean   @default(true)
  shippingCents Int?
  lastSeen      DateTime? @default(now())

  clicks Click[] // back-relation pour Click.offer

  @@unique([skuId, merchantId])
}

model Click {
  id                BigInt   @id @default(autoincrement())
  offer             Offer    @relation(fields: [offerId], references: [id])
  offerId           Int
  product           Product  @relation(fields: [productId], references: [id])
  productId         Int
  priceCentsAtClick Int
  subId             String?
  ts                DateTime @default(now())
  referrer          String?
}

/* -----------------------------
   AVIS & TESTS (avec modération)
------------------------------ */
enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int
  userId     String?  // auteur connecté (facultatif)
  rating     Int // 1..5
  title      String
  body       String
  authorName String?
  sourceName String? // “Ekosport”, “Snowleader”, etc.
  sourceUrl  String?
  status     ModerationStatus @default(PENDING)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([rating])
  @@index([status])
}

model EditorialTest {
  id          Int      @id @default(autoincrement())
  productId   Int
  userId      String?  // auteur connecté (facultatif)
  title       String
  excerpt     String
  score       Float? // 0..10 ou 0..5 (optionnel)
  sourceName  String // “Skipass”, “Backcountry Magazine”, etc.
  sourceUrl   String
  status      ModerationStatus @default(PENDING)
  publishedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([publishedAt])
  @@index([status])
}

/* -----------------------------
   CMS Catégorie (texte + SEO)
------------------------------ */
model CategoryPage {
  slug            String   @id
  name            String
  intro           String?
  content         String?
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* -----------------------------
   Journal d’import (Kwanko, etc.)
------------------------------ */
model ImportRun {
  id              Int      @id @default(autoincrement())
  source          String   // "kwanko"
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  offersUpserted  Int      @default(0)
  offersDisabled  Int      @default(0)
  notes           String?
}
