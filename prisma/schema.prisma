generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * -----------------------------
 * AUTH (NextAuth / PrismaAdapter)
 * ------------------------------
 */
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)

  siteId String?

  avatarId                Int?
  avatar                  MediaAsset?              @relation("UserAvatar", fields: [avatarId], references: [id])
  mediaCreated            MediaAsset[]             @relation("MediaCreatedBy")
  emailVerificationTokens EmailVerificationToken[]

  pseudo         String?
  firstName      String?
  lastName       String?
  marketingOptIn Boolean @default(false)
  passwordHash   String?

  accounts Account[]
  sessions Session[]

  reviews Review[]
  tests   EditorialTest[]

  pages        Page[]
  pageComments PageComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  USER
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?
  websiteUrl  String? @db.VarChar(512)

  logoUrl String?     @db.VarChar(512)
  logoId  Int?
  logo    MediaAsset? @relation("BrandLogo", fields: [logoId], references: [id])

  bannerUrl String?     @db.VarChar(512)
  bannerId  Int?
  banner    MediaAsset? @relation("BrandBanner", fields: [bannerId], references: [id])

  metaTitle       String?
  metaDescription String?

  showInFooter Boolean @default(false)
  footerOrder  Int     @default(0)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showOnHomepage       Boolean                @default(false)
  featuredInCategories CategoryFeaturedLink[]
  products             Product[]
}

model GuideCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isInMenu    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages Page[]

  @@index([order])
  @@index([active, isInMenu])
  @@index([slug])
}

model Page {
  id           Int         @id @default(autoincrement())
  slug         String      @unique
  title        String
  content      String      @db.Text
  intro        String?
  thumbnailUrl String?
  thumbnailId  Int?
  thumbnail    MediaAsset? @relation("PageThumbnail", fields: [thumbnailId], references: [id])
  bannerUrl    String?
  bannerId     Int?
  banner       MediaAsset? @relation("PageBanner", fields: [bannerId], references: [id])

  kind PageKind @default(ARTICLE)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  guideCategoryId Int?
  guideCategory   GuideCategory? @relation(fields: [guideCategoryId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaTitle       String?
  metaDescription String?

  showInFooter Boolean @default(false)
  footerOrder  Int     @default(0)

  tags                 String[]
  featuredInCategories CategoryFeaturedLink[]
  comments             PageComment[]

  @@index([kind, published])
  @@index([guideCategoryId])
}

enum PageKind {
  GUIDE
  COMPARATIF
  ARTICLE
}

model PageComment {
  id     Int  @id @default(autoincrement())
  pageId Int
  page   Page @relation(fields: [pageId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  published Boolean  @default(true)
}

/**
 * -----------------------------
 * CATALOGUE / OFFRES
 * ------------------------------
 */
model Product {
  id Int @id @default(autoincrement())

  // Nouveau champ principal
  name String?

  // Champs historiques conservés temporairement pour éviter migration destructive
  brand String?
  model String
  gtin  String? @unique

  brandId Int?
  Brand   Brand? @relation(fields: [brandId], references: [id])

  season String?

  categoryId Int?
  category   Category?         @relation("ProductPrimaryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  categories ProductCategory[]

  slug        String   @unique
  attributes  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  description String?

  normalizedName        String?
  manufacturerReference String?
  imageUrl              String? @db.VarChar(1024)
  published             Boolean @default(false)
  active                Boolean @default(true)

  skus        Sku[]
  offers      Offer[]
  clicks      Click[]
  reviews     Review[]
  tests       EditorialTest[]
  sites       SiteProduct[]
  identifiers ProductIdentifier[]

  @@index([brandId])
  @@index([categoryId])
  @@index([normalizedName])
  @@index([manufacturerReference])
  @@index([published])
  @@index([active])
}

enum ProductIdentifierType {
  GTIN
  STYLE_CODE
  MANUFACTURER_REFERENCE
  MERCHANT_PARENT_ID
  SOURCE_GROUP_KEY
}

model ProductIdentifier {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  siteId String
  type   ProductIdentifierType
  value  String

  /**
   * brandKey et merchantSlug restent non-nullables afin que
   * l'unicité fonctionne correctement dans PostgreSQL.
   * Valeur vide = identifiant global au site.
   */
  brandKey     String @default("")
  merchantSlug String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, type, value, brandKey, merchantSlug])
  @@index([productId])
  @@index([siteId, type, value])
  @@index([siteId, type, brandKey, value])
  @@index([siteId, type, merchantSlug, value])
}

model Sku {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  // Nouveau champ principal d'affichage variante
  displayName String?

  // Champs historiques conservés temporairement
  variant String?
  gtin    String? @unique

  attributes Json?

  merchantSku           String?
  manufacturerReference String?
  size                  String?
  color                 String?
  gender                String?
  normalizedVariant     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([productId])
  @@index([merchantSku])
  @@index([manufacturerReference])
  @@index([size])
  @@index([normalizedVariant])
}

enum MerchantNetwork {
  KWANKO
  AWIN
  AFFILAE
  DIRECT
  OTHER
}

model Merchant {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  // Nouveau champ typé
  platform MerchantNetwork @default(OTHER)

  // Ancien champ conservé temporairement
  network String?

  programId String?
  status    String?

  websiteUrl String? @db.VarChar(512)
  active     Boolean @default(true)

  offers            Offer[]
  feedImports       FeedImport[]
  affiliatePrograms AffiliateProgram[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Offer {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  affiliateProgramId Int?
  affiliateProgram   AffiliateProgram? @relation(fields: [affiliateProgramId], references: [id], onDelete: SetNull)

  feedSourceId Int?
  feedSource   FeedSource? @relation(fields: [feedSourceId], references: [id], onDelete: SetNull)

  affiliateUrl String @db.VarChar(2048)

  merchantProductUrl String? @db.VarChar(2048)

  externalId       String?
  parentExternalId String?

  priceCents    Int
  oldPriceCents Int?

  shippingCents Int?

  currency String @default("EUR")

  inStock Boolean @default(true)

  availability String?

  imageUrl String? @db.VarChar(1024)

  active     Boolean   @default(true)
  archivedAt DateTime?

  lastSeen        DateTime? @default(now())
  feedKey         String?
  sourceItemCount Int       @default(1)

  clicks       Click[]
  priceHistory PriceHistory[]

  @@unique([productId, merchantId])
  @@index([productId])
  @@index([merchantId])
  @@index([affiliateProgramId])
  @@index([feedSourceId])
  @@index([externalId])
  @@index([parentExternalId])
  @@index([inStock])
  @@index([active])
  @@index([lastSeen])
  @@index([feedKey])
  @@index([merchantId, feedKey, lastSeen])
}

model PriceHistory {
  id      Int   @id @default(autoincrement())
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId Int

  priceCents    Int
  oldPriceCents Int?
  shippingCents Int?
  currency      String  @default("EUR")
  inStock       Boolean @default(true)

  recordedAt DateTime @default(now())

  @@index([offerId])
  @@index([recordedAt])
}

model Click {
  id                BigInt   @id @default(autoincrement())
  offer             Offer    @relation(fields: [offerId], references: [id])
  offerId           Int
  product           Product  @relation(fields: [productId], references: [id])
  productId         Int
  priceCentsAtClick Int
  subId             String?
  ts                DateTime @default(now())
  referrer          String?
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         Int              @id @default(autoincrement())
  productId  Int
  userId     String?
  rating     Int
  title      String
  body       String
  authorName String?
  sourceName String?
  sourceUrl  String?
  status     ModerationStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([rating])
  @@index([status])
}

model EditorialTest {
  id        Int     @id @default(autoincrement())
  productId Int
  userId    String?
  title     String
  excerpt   String
  content   String? @db.Text

  bannerUrl String?
  bannerId  Int?
  banner    MediaAsset? @relation("TestBanner", fields: [bannerId], references: [id])

  score Float?

  sourceName String
  sourceUrl  String

  status      ModerationStatus @default(PENDING)
  publishedAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  ratings EditorialTestScore[]

  @@index([productId])
  @@index([publishedAt])
  @@index([status])
}

model TestRatingCategory {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  label     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores EditorialTestScore[]
}

model EditorialTestScore {
  testId     Int
  categoryId Int
  score      Int

  test     EditorialTest      @relation(fields: [testId], references: [id])
  category TestRatingCategory @relation(fields: [categoryId], references: [id])

  @@id([testId, categoryId])
}

model Category {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  intro           String?
  content         String?
  metaTitle       String?
  metaDescription String?
  thumbnailUrl    String?
  thumbnailId     Int?
  thumbnail       MediaAsset? @relation("CategoryThumbnail", fields: [thumbnailId], references: [id])

  isInMenu  Boolean @default(true)
  order     Int     @default(0)
  published Boolean @default(true)

  showInFooter Boolean @default(false)
  footerOrder  Int     @default(0)

  mapKwanko     String[]
  mapEkosport   String[]
  mapSnowleader String[]
  mapGlisshop   String[]

  aliases        String[]
  showOnHomepage Boolean  @default(false)

  primaryProducts  Product[]                 @relation("ProductPrimaryCategory")
  products         ProductCategory[]
  pages            Page[]
  featuredLinks    CategoryFeaturedLink[]
  externalMappings CategoryExternalMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrichmentRulesAsSource CategoryEnrichmentRule[] @relation("CategoryEnrichmentSource")
  enrichmentRulesAsTarget CategoryEnrichmentRule[] @relation("CategoryEnrichmentTarget")

  @@index([parentId, order])
  @@index([slug])
  @@index([published])
}

model ProductCategory {
  productId  Int
  categoryId Int
  isPrimary  Boolean @default(false)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
  @@index([categoryId, isPrimary])
}

/**
 * -----------------------------
 * IMPORTS PRODUITS / FLUX AFFILIÉS
 * ------------------------------
 */

model AffiliateNetwork {
  id Int @id @default(autoincrement())

  name String
  slug String @unique

  websiteUrl String? @db.VarChar(512)
  active     Boolean @default(true)

  programs AffiliateProgram[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model AffiliateProgram {
  id Int @id @default(autoincrement())

  siteId String

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  networkId Int
  network   AffiliateNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  name              String?
  externalProgramId String?
  trackingId        String?
  active            Boolean @default(true)

  feeds  FeedSource[]
  offers Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, merchantId, networkId])
  @@index([siteId])
  @@index([merchantId])
  @@index([networkId])
  @@index([active])
}

model FeedSource {
  id Int @id @default(autoincrement())

  siteId String

  affiliateProgramId Int
  affiliateProgram   AffiliateProgram @relation(fields: [affiliateProgramId], references: [id], onDelete: Cascade)

  name String
  slug String

  sourceUrl String @db.VarChar(2048)

  format    FeedFormat @default(CSV)
  delimiter String     @default(";")
  encoding  String     @default("utf-8")

  active     Boolean @default(true)
  autoImport Boolean @default(false)

  frequency FeedFrequency @default(MANUAL_ONLY)
  timezone  String        @default("Europe/Paris")

  lastRunAt        DateTime?
  nextRunAt        DateTime?
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  lastStatus       FeedImportStatus?
  lastErrorMessage String?           @db.Text

  columnMappings   FeedColumnMapping[]
  categoryMappings CategoryExternalMapping[]
  enrichmentRules  CategoryEnrichmentRule[]
  imports          FeedImport[]
  offers           Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([affiliateProgramId])
  @@index([active, autoImport])
  @@index([nextRunAt])
}

model FeedColumnMapping {
  id Int @id @default(autoincrement())

  feedSourceId Int
  feedSource   FeedSource @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)

  targetField     String
  sourceColumn    String
  fallbackColumns String[]
  required        Boolean  @default(false)
  defaultValue    String?
  transform       String?
  order           Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feedSourceId, targetField])
  @@index([feedSourceId])
  @@index([targetField])
}

model CategoryExternalMapping {
  id Int @id @default(autoincrement())

  feedSourceId Int
  feedSource   FeedSource @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  externalPath           String
  normalizedExternalPath String
  priority               Int     @default(0)
  active                 Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([feedSourceId, normalizedExternalPath, categoryId])
  @@index([feedSourceId])
  @@index([categoryId])
  @@index([active])
}

model SiteProduct {
  id Int @id @default(autoincrement())

  siteId    String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  published Boolean @default(false)
  active    Boolean @default(true)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, productId])
  @@index([siteId, published])
  @@index([siteId, active])
  @@index([productId])
}

enum FeedFormat {
  CSV
  TSV
  XML
  JSON
}

enum FeedFrequency {
  MANUAL_ONLY
  EVERY_6_HOURS
  EVERY_12_HOURS
  DAILY
  WEEKLY
}

enum FeedImportStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  CANCELLED
}

enum FeedImportTrigger {
  MANUAL
  CRON
  API
  RETRY
}

enum CategoryEnrichmentMatchMode {
  ANY
  ALL
}

model FeedImport {
  id         Int      @id @default(autoincrement())
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  merchantId Int

  feedSourceId Int?
  feedSource   FeedSource? @relation(fields: [feedSourceId], references: [id], onDelete: SetNull)

  siteId  String?
  trigger FeedImportTrigger @default(MANUAL)

  platform     String?
  filename     String?
  feedKey      String?
  sourceUrl    String?           @db.VarChar(2048)
  status       String            @default("pending")
  statusV2     FeedImportStatus?
  notes        String?
  errorMessage String?           @db.Text

  totalRows           Int @default(0)
  importedRows        Int @default(0)
  createdProducts     Int @default(0)
  updatedProducts     Int @default(0)
  createdSkus         Int @default(0)
  updatedSkus         Int @default(0)
  createdOffers       Int @default(0)
  updatedOffers       Int @default(0)
  unchangedProducts   Int @default(0)
  restoredProducts    Int @default(0)
  unchangedOffers     Int @default(0)
  restoredOffers      Int @default(0)
  skippedRows         Int @default(0)
  deactivatedOffers   Int @default(0)
  deactivatedProducts Int @default(0)
  deletedProducts     Int @default(0)
  errorsCount         Int @default(0)
  warningsCount       Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  rawProducts RawFeedProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([feedSourceId])
  @@index([siteId])
  @@index([status])
  @@index([statusV2])
  @@index([startedAt])
  @@index([feedKey])
}

model RawFeedProduct {
  id           Int        @id @default(autoincrement())
  feedImport   FeedImport @relation(fields: [feedImportId], references: [id], onDelete: Cascade)
  feedImportId Int

  merchantId Int

  externalId       String?
  parentExternalId String?
  ean              String?
  manufacturerRef  String?
  title            String?
  brand            String?

  rawData Json

  processed Boolean @default(false)
  error     String?

  matchedProductId Int?
  matchedSkuId     Int?
  matchedOfferId   Int?

  createdAt DateTime @default(now())

  @@index([feedImportId])
  @@index([merchantId])
  @@index([ean])
  @@index([manufacturerRef])
  @@index([externalId])
  @@index([processed])
}

model CategoryEnrichmentRule {
  id Int @id @default(autoincrement())

  name String

  /**
   * Permet de limiter la règle à un site.
   * Exemple : meilleur-ski.
   */
  siteId String

  /**
   * Si feedSourceId est renseigné, la règle ne s'applique
   * qu'à ce flux.
   * Si feedSourceId est null, elle s'applique à tous les flux
   * du site.
   */
  feedSourceId Int?
  feedSource   FeedSource? @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)

  /**
   * Catégorie dans laquelle le produit doit déjà se trouver
   * pour que la règle puisse s'appliquer.
   * Facultatif : une règle sans catégorie source peut
   * s'appliquer à tous les produits du site.
   */
  sourceCategoryId Int?
  sourceCategory   Category? @relation("CategoryEnrichmentSource", fields: [sourceCategoryId], references: [id], onDelete: Cascade)

  /**
   * Catégorie précise à ajouter au produit.
   */
  targetCategoryId Int
  targetCategory   Category @relation("CategoryEnrichmentTarget", fields: [targetCategoryId], references: [id], onDelete: Cascade)

  /**
   * Termes recherchés dans les données du produit.
   * Les recherches sont insensibles à la casse et aux accents.
   */
  includeTerms String[]
  excludeTerms String[]

  /**
   * ANY :
   * au moins un terme doit être présent.
   * ALL :
   * tous les termes doivent être présents.
   */
  matchMode CategoryEnrichmentMatchMode @default(ANY)

  searchTitle        Boolean @default(true)
  searchDescription  Boolean @default(true)
  searchCategoryPath Boolean @default(true)
  searchBrand        Boolean @default(false)

  /**
   * Si true, la catégorie cible devient la catégorie principale.
   * Sinon, elle est simplement ajoutée comme catégorie secondaire.
   */
  makePrimary Boolean @default(true)

  priority Int     @default(0)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([feedSourceId])
  @@index([sourceCategoryId])
  @@index([targetCategoryId])
  @@index([active, priority])
}

/**
 * Ancien journal conservé temporairement.
 * Il pourra être supprimé quand le BO utilisera FeedImport.
 */
model ImportRun {
  id             Int       @id @default(autoincrement())
  source         String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  offersUpserted Int       @default(0)
  offersDisabled Int       @default(0)
  notes          String?
}

model SiteSettings {
  id     Int    @id @default(autoincrement())
  siteId String @unique

  name       String?
  tagline    String?
  logoSrc    String?
  logoAlt    String?
  faviconSrc String?

  primary         String
  secondary       String
  accent          String
  background      String
  foreground      String
  muted           String
  mutedForeground String
  border          String

  fontSans    String
  fontDisplay String

  heroTitle     String?
  heroHighlight String?
  heroSubtitle  String?
  heroCtas      Json?

  showCategories   Boolean @default(true)
  showLatestGuides Boolean @default(true)
  showTopBrands    Boolean @default(true)

  categoryTiles Json?
  topBrands     Json?
  pagesContent  Json?

  footerTrustTitle String?
  footerTrustItems Json?
  footerCopyright  String?

  contentSettings Json?

  robotsIndex     Boolean @default(true)
  robotsFollow    Boolean @default(true)
  robotsNoarchive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model MediaAsset {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String?
  alt         String?
  kind        MediaKind @default(IMAGE)
  mime        String
  width       Int?
  height      Int?
  bytes       Int?
  storageKey  String    @unique
  publicUrl   String    @db.VarChar(1024)
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation(name: "MediaCreatedBy", fields: [createdById], references: [id])

  categoriesThumbnail Category[] @relation("CategoryThumbnail")

  brandsLogo     Brand[]         @relation("BrandLogo")
  brandsBanner   Brand[]         @relation("BrandBanner")
  pagesThumbnail Page[]          @relation("PageThumbnail")
  pagesBanner    Page[]          @relation("PageBanner")
  usersAvatar    User[]          @relation("UserAvatar")
  testsBanner    EditorialTest[] @relation("TestBanner")
}

enum MediaKind {
  IMAGE
}

enum CookiePurpose {
  ESSENTIAL
  ANALYTICS
  ADS
  PERSONALIZATION
}

enum ConsentChoice {
  ESSENTIAL
  ALL
}

model CookieDefinition {
  id           Int           @id @default(autoincrement())
  siteId       String?
  key          String
  name         String
  provider     String?
  purpose      CookiePurpose @default(ESSENTIAL)
  description  String?
  durationDays Int?
  mandatory    Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, key])
  @@index([siteId])
  @@index([purpose])
}

model CookieConsentLog {
  id        String        @id @default(cuid())
  siteId    String?
  choice    ConsentChoice
  version   String
  userAgent String?
  path      String?
  createdAt DateTime      @default(now())

  @@index([siteId])
  @@index([createdAt])
}

model AdSettings {
  id     Int    @id @default(autoincrement())
  siteId String @unique

  enabled       Boolean @default(false)
  adsenseClient String?

  slotPageTop     String?
  slotPageInline  String?
  slotPageSidebar String?
  slotPageBottom  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

enum AdPlacementType {
  ADSENSE
  AFFILIATE_BANNER
  CUSTOM_HTML
}

model AdPlacement {
  id      Int     @id @default(autoincrement())
  siteId  String
  key     String
  enabled Boolean @default(true)

  type AdPlacementType @default(ADSENSE)

  adsenseSlot String?
  customHtml  String? @db.Text

  bannerImageUrl String?
  bannerAlt      String?
  bannerLinkUrl  String?
  bannerTitle    String?

  openInNewTab Boolean @default(true)
  nofollow     Boolean @default(true)
  sponsored    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, key])
  @@index([siteId])
  @@index([key])
}

model TrackingSettings {
  id     Int    @id @default(autoincrement())
  siteId String @unique

  enabledAnalytics Boolean @default(false)
  enabledAds       Boolean @default(false)
  enabledGtm       Boolean @default(false)

  ga4MeasurementId         String?
  googleAdsId              String?
  googleAdsConversionLabel String?
  gtmContainerId           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model CategoryFeaturedLink {
  id Int @id @default(autoincrement())

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  pageId Int?
  page   Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  brandId Int?
  brand   Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  type  FeaturedLinkType
  order Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([type])
  @@index([order])
}

enum FeaturedLinkType {
  GUIDE
  BRAND
}

model LegalPage {
  id     Int           @id @default(autoincrement())
  siteId String
  type   LegalPageType

  title   String
  content String @db.Text

  metaTitle       String?
  metaDescription String?

  published Boolean @default(false)

  version       String?
  effectiveDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, type])
  @@index([siteId])
  @@index([siteId, published])
}

enum LegalPageType {
  LEGAL_NOTICE
  PRIVACY_POLICY
  COOKIE_POLICY
  TERMS_OF_USE
  CONTACT
}
