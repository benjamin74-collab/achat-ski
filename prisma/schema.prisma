generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * -----------------------------
 * AUTH (NextAuth / PrismaAdapter)
 * ------------------------------
 */
model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String?                  @unique
  emailVerified           DateTime?
  image                   String?
  role                    Role                     @default(USER)

  // Multi-site : null = super-admin (tous sites), sinon slug du site (ex: "meilleur-robot")
  siteId                  String?

  avatarId                Int?
  avatar                  MediaAsset?              @relation("UserAvatar", fields: [avatarId], references: [id])
  mediaCreated            MediaAsset[]             @relation("MediaCreatedBy")
  emailVerificationTokens EmailVerificationToken[]

  pseudo         String?
  firstName      String?
  lastName       String?
  marketingOptIn Boolean @default(false)
  passwordHash   String?

  // Relations NextAuth
  accounts Account[]
  sessions Session[]

  // Relations existantes
  reviews Review[]
  tests   EditorialTest[]

  // Relations inverses ajoutées
  pages        Page[]
  pageComments PageComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  USER
}

model Brand {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  slug        String      @unique
  description String?
  websiteUrl  String?     @db.VarChar(512)

  logoUrl     String?     @db.VarChar(512)
  logoId      Int?
  logo        MediaAsset? @relation("BrandLogo", fields: [logoId], references: [id])

  bannerUrl   String?     @db.VarChar(512)
  bannerId    Int?
  banner      MediaAsset? @relation("BrandBanner", fields: [bannerId], references: [id])

  metaTitle       String?
  metaDescription String?
  
  showInFooter Boolean @default(false)
  footerOrder  Int     @default(0)

  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  showOnHomepage Boolean @default(false)
  featuredInCategories CategoryFeaturedLink[]
  products Product[]
}

model GuideCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isInMenu    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages Page[]

  @@index([order])
  @@index([active, isInMenu])
  @@index([slug])
}

model Page {
  id           Int         @id @default(autoincrement())
  slug         String      @unique
  title        String
  content      String      @db.Text
  intro        String?
  thumbnailUrl String?
  thumbnailId  Int?
  thumbnail    MediaAsset? @relation("PageThumbnail", fields: [thumbnailId], references: [id])
  bannerUrl    String?
  bannerId     Int?
  banner       MediaAsset? @relation("PageBanner", fields: [bannerId], references: [id])

  kind PageKind @default(ARTICLE)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  guideCategoryId Int?
  guideCategory   GuideCategory? @relation(fields: [guideCategoryId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaTitle       String?
  metaDescription String?

  showInFooter Boolean @default(false)
  footerOrder  Int     @default(0)

  tags String[]
  featuredInCategories CategoryFeaturedLink[]
  comments PageComment[]

  @@index([kind, published])
  @@index([guideCategoryId])
}

enum PageKind {
  GUIDE
  COMPARATIF
  ARTICLE
}

model PageComment {
  id     Int  @id @default(autoincrement())
  pageId Int
  page   Page @relation(fields: [pageId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  published Boolean  @default(true)
}

/**
 * -----------------------------
 * CATALOGUE / OFFRES
 * ------------------------------
 */
model Product {
  id      Int     @id @default(autoincrement())
  brand   String?
  brandId Int?
  Brand   Brand?  @relation(fields: [brandId], references: [id])
  model   String
  season  String?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  gtin        String?         @unique
  slug        String          @unique
  attributes  Json?
  createdAt   DateTime        @default(now())
  description String?
  skus        Sku[]
  clicks      Click[]
  reviews     Review[]
  tests       EditorialTest[]

  @@index([brandId])
  @@index([categoryId])
}

model Sku {
  id         Int     @id @default(autoincrement())
  product    Product @relation(fields: [productId], references: [id])
  productId  Int
  variant    String?
  gtin       String? @unique
  attributes Json?
  offers     Offer[]
}

model Merchant {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  slug      String  @unique
  network   String?
  programId String?
  status    String?
  offers    Offer[]
}

model Offer {
  id            Int       @id @default(autoincrement())
  sku           Sku       @relation(fields: [skuId], references: [id])
  skuId         Int
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  merchantId    Int
  affiliateUrl  String
  priceCents    Int
  currency      String
  inStock       Boolean   @default(true)
  shippingCents Int?
  lastSeen      DateTime? @default(now())

  clicks Click[]

  @@unique([skuId, merchantId])
}

model Click {
  id                BigInt   @id @default(autoincrement())
  offer             Offer    @relation(fields: [offerId], references: [id])
  offerId           Int
  product           Product  @relation(fields: [productId], references: [id])
  productId         Int
  priceCentsAtClick Int
  subId             String?
  ts                DateTime @default(now())
  referrer          String?
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         Int              @id @default(autoincrement())
  productId  Int
  userId     String?
  rating     Int
  title      String
  body       String
  authorName String?
  sourceName String?
  sourceUrl  String?
  status     ModerationStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([rating])
  @@index([status])
}

model EditorialTest {
  id        Int     @id @default(autoincrement())
  productId Int
  userId    String?
  title     String
  excerpt   String
  content   String? @db.Text

  bannerUrl String?
  bannerId  Int?
  banner    MediaAsset? @relation("TestBanner", fields: [bannerId], references: [id])

  score Float?

  sourceName String
  sourceUrl  String

  status      ModerationStatus @default(PENDING)
  publishedAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  ratings EditorialTestScore[]

  @@index([productId])
  @@index([publishedAt])
  @@index([status])
}

model TestRatingCategory {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  label     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores EditorialTestScore[]
}

model EditorialTestScore {
  testId     Int
  categoryId Int
  score      Int

  test     EditorialTest      @relation(fields: [testId], references: [id])
  category TestRatingCategory @relation(fields: [categoryId], references: [id])

  @@id([testId, categoryId])
}

model Category {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  intro           String?
  content         String?
  metaTitle       String?
  metaDescription String?
  thumbnailUrl String?
  thumbnailId  Int?
  thumbnail    MediaAsset? @relation("CategoryThumbnail", fields: [thumbnailId], references: [id])

  isInMenu  Boolean @default(true)
  order     Int     @default(0)
  published Boolean @default(true)
  
  showInFooter Boolean @default(false)
  footerOrder  Int     @default(0)

  mapKwanko     String[]
  mapEkosport   String[]
  mapSnowleader String[]
  mapGlisshop   String[]

  aliases String[]
  showOnHomepage Boolean @default(false)

  products Product[]
  pages    Page[]
  featuredLinks CategoryFeaturedLink[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, order])
  @@index([slug])
  @@index([published])
}

model ImportRun {
  id             Int       @id @default(autoincrement())
  source         String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  offersUpserted Int       @default(0)
  offersDisabled Int       @default(0)
  notes          String?
}

model SiteSettings {
  id     Int    @id @default(autoincrement())
  siteId String @unique

  name       String?
  tagline    String?
  logoSrc    String?
  logoAlt    String?
  faviconSrc String?

  primary          String
  secondary        String
  accent           String
  background       String
  foreground       String
  muted            String
  mutedForeground  String
  border           String

  fontSans    String
  fontDisplay String

  heroTitle     String?
  heroHighlight String?
  heroSubtitle  String?
  heroCtas      Json?

  showCategories   Boolean @default(true)
  showLatestGuides Boolean @default(true)
  showTopBrands    Boolean @default(true)

  categoryTiles Json?
  topBrands     Json?
  
  footerTrustTitle     String?
  footerTrustItems     Json?
  footerCopyright      String?
  
  robotsIndex     Boolean @default(true)
  robotsFollow    Boolean @default(true)
  robotsNoarchive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model MediaAsset {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String?
  alt         String?
  kind        MediaKind @default(IMAGE)
  mime        String
  width       Int?
  height      Int?
  bytes       Int?
  storageKey  String    @unique
  publicUrl   String    @db.VarChar(1024)
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation(name: "MediaCreatedBy", fields: [createdById], references: [id])
  categoriesThumbnail Category[] @relation("CategoryThumbnail")

  brandsLogo     Brand[]         @relation("BrandLogo")
  brandsBanner   Brand[]         @relation("BrandBanner")
  pagesThumbnail Page[]          @relation("PageThumbnail")
  pagesBanner    Page[]          @relation("PageBanner")
  usersAvatar    User[]          @relation("UserAvatar")
  testsBanner    EditorialTest[] @relation("TestBanner")
}

enum MediaKind {
  IMAGE
}

enum CookiePurpose {
  ESSENTIAL
  ANALYTICS
  ADS
  PERSONALIZATION
}

enum ConsentChoice {
  ESSENTIAL
  ALL
}

model CookieDefinition {
  id           Int           @id @default(autoincrement())
  siteId       String?
  key          String
  name         String
  provider     String?
  purpose      CookiePurpose @default(ESSENTIAL)
  description  String?
  durationDays Int?
  mandatory    Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([purpose])
  @@unique([siteId, key])
}

model CookieConsentLog {
  id        String        @id @default(cuid())
  siteId    String?
  choice    ConsentChoice
  version   String
  userAgent String?
  path      String?
  createdAt DateTime      @default(now())

  @@index([siteId])
  @@index([createdAt])
}

model AdSettings {
  id            Int      @id @default(autoincrement())
  siteId        String   @unique

  enabled       Boolean  @default(false)
  adsenseClient String?

  slotPageTop     String?
  slotPageInline  String?
  slotPageSidebar String?
  slotPageBottom  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

enum AdPlacementType {
  ADSENSE
  AFFILIATE_BANNER
  CUSTOM_HTML
}

model AdPlacement {
  id      Int    @id @default(autoincrement())
  siteId  String
  key     String
  enabled Boolean @default(true)

  type AdPlacementType @default(ADSENSE)

  adsenseSlot String?
  customHtml String? @db.Text

  bannerImageUrl String?
  bannerAlt      String?
  bannerLinkUrl  String?
  bannerTitle    String?

  openInNewTab Boolean @default(true)
  nofollow     Boolean @default(true)
  sponsored    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, key])
  @@index([siteId])
  @@index([key])
}

model TrackingSettings {
  id                       Int      @id @default(autoincrement())
  siteId                   String   @unique

  enabledAnalytics         Boolean  @default(false)
  enabledAds               Boolean  @default(false)
  enabledGtm               Boolean  @default(false)

  ga4MeasurementId         String?
  googleAdsId              String?
  googleAdsConversionLabel String?
  gtmContainerId           String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([siteId])
}

model CategoryFeaturedLink {
  id Int @id @default(autoincrement())

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  pageId Int?
  page   Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  brandId Int?
  brand   Brand? @relation(fields: [brandId], references: [id], onDelete: Cascade)

  type  FeaturedLinkType
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([type])
  @@index([order])
}

enum FeaturedLinkType {
  GUIDE
  BRAND
}